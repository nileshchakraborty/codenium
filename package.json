{
  "name": "codenium",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "system-design/frontend",
    "api"
  ],
  "scripts": {
    "build": "npm install --prefix frontend && make build",
    "build:system-design": "npm install --prefix system-design/frontend && cd system-design/frontend && npm run build",
    "prepare": "if [ \"$NODE_ENV\" != \"production\" ] && command -v husky > /dev/null 2>&1; then husky; fi"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.97.0",
    "axios": "^1.13.5",
    "axios-retry": "^4.5.0",
    "cors": "^2.8.6",
    "dotenv": "^16.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "google-auth-library": "^10.5.0",
    "ioredis": "^5.8.2",
    "mongodb": "^7.0.0",
    "node-cache": "^5.1.2",
    "openai": "^4.20.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router": "7.13.0",
    "react-router-dom": "7.13.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/express-rate-limit": "^5.1.3",
    "@types/node": "^20.10.4",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^4.0.16",
    "husky": "^9.1.7",
    "nodemon": "^3.0.2",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3",
    "vitest": "^4.0.16"
  }
}
