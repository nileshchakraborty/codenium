{
  "name": "codenium",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "system-design/frontend",
    "api"
  ],
  "scripts": {
    "build": "npm install --prefix frontend && make build",
    "build:system-design": "npm install --prefix system-design/frontend && cd system-design/frontend && npm run build",
    "prepare": "if [ \"$NODE_ENV\" != \"production\" ] && command -v husky > /dev/null 2>&1; then husky; fi"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.98.0",
    "axios": "^1.13.6",
    "axios-retry": "^4.5.0",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.0",
    "google-auth-library": "^10.6.1",
    "ioredis": "^5.10.0",
    "mongodb": "^7.1.0",
    "node-cache": "^5.1.2",
    "openai": "^6.26.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-router": "7.13.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@excalidraw/excalidraw": "^0.18.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/express-rate-limit": "^6.0.2",
    "@types/node": "^25.3.3",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^11.0.0",
    "@vitest/coverage-v8": "^4.0.18",
    "husky": "^9.1.7",
    "monaco-editor": "^0.55.1",
    "nodemon": "^3.1.14",
    "react-router-dom": "^7.13.1",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3",
    "vitest": "^4.0.16"
  }
}
